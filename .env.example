# ============================================================
# fcfs-minter — environment template
# Copy to .env:   cp .env.example .env
# ============================================================

# --- Wallet ---------------------------------------------------
# One of the following, in priority order:
#   A. PRIVATE_KEY          — single key (64 hex)
#   B. PRIVATE_KEYS         — comma-separated keys
#   C. wallets.txt          — one key per line (see wallets.txt.example)
# Keys are loaded from all sources that are populated.
PRIVATE_KEY=0xYOUR_BURNER_PRIVATE_KEY_HERE
# PRIVATE_KEYS=0xaaa...,0xbbb...

# --- Drop target ----------------------------------------------
# Slug from the collection URL: https://opensea.io/collection/<slug>
COLLECTION_SLUG=my-drop-slug

# NFT contract address (0x...) — from the drop page / block explorer
NFT_CONTRACT=0xNFT_CONTRACT_ADDRESS_HERE

# Chain identifier matching the drop: base | robinhood | ethereum
CHAIN=base

# Mint quantity per wallet; TOKEN_ID is used for ERC-1155 (ERC-721 uses 0)
QUANTITY=1
TOKEN_ID=0

# --- RPC ------------------------------------------------------
# Primary RPC. Add RPC_URLS (comma-separated) for multi-RPC blast redundancy.
RPC_URL=https://mainnet.base.org
# RPC_URLS=https://rpc2.example.com,https://rpc3.example.com

# --- Gas (fixed — never estimate in the hot path) -------------
MAX_FEE_GWEI=1.0
MAX_PRIORITY_GWEI=0.05
GAS_LIMIT=300000

# --- Timing ----------------------------------------------------
WARMUP_SECONDS=5
HAMMER_EARLY_SECONDS=1.5
SCHEDULE_POLL_SECONDS=30

# Optional: override the drop's start time (ISO-8601 UTC). Empty = use dropBySlug.
FORCE_MINT_AT=

# --- Safety -----------------------------------------------------
# 0 = never broadcast (default). 1 = broadcast via eth_sendRawTransaction.
LIVE=0
# When set, fetch swap calldata even if LIVE=0 (dry fetch).
DRY_FET

# --- OpenSea internal API (rarely changed) ----------------------
AUTH_BASE=https://opensea.io/__api
GQL_URL=https://gql.opensea.io/graphql
SIWE_DOMAIN=opensea.io
SIWE_URI=https://opensea.io/
# EVM chain id for SIWE: Base=8453, Ethereum=1, Robinhood=4663
SIWE_CHAIN_ID=8453
CONNECTOR_ID=injected
